NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=you@example.com
# International format, digits only (e.g. 2376XXXXXXXX)
WHATSAPP_NUMBER=237600000000
MAX_DEVICES_PER_CODE=2
APP_URL=http://localhost:3000

# Price of a course in FCFA, and the discount a friend gets with a referral link
COURSE_PRICE_XAF=850
REFERRAL_DISCOUNT_XAF=100

# Fapshi Mobile Money (optional; without it, "Buy" goes to WhatsApp)
FAPSHI_API_USER=
FAPSHI_API_KEY=
# sandbox or live
FAPSHI_ENV=sandbox
FAPSHI_WEBHOOK_SECRET=

# Writing tutor (optional): Anthropic API key, and max tutor requests per access code
ANTHROPIC_API_KEY=
TUTOR_LIMIT=30

# Real-world mission (optional): inbox learners send their application to,
# and the secret your inbound-email forwarder sends in the x-inbound-secret header
MISSION_EMAIL=
INBOUND_SECRET=
